# Supabase > Project Settings > API
#
# Copiar este archivo a .env.local y completar los valores.
# .env.local esta en .gitignore y no se sube al repositorio.

# URL del proyecto. Ej: https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / public key. Es publica por diseno: viaja al navegador.
# Lo que protege los datos son las politicas de RLS, no esta clave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key. SALTEA TODO EL RLS.
# Solo la usa `npm run seed`. Nunca ponerla en codigo del cliente ni commitearla.
SUPABASE_SERVICE_ROLE_KEY=
